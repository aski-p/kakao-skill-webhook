# Claude API Configuration
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-haiku-4-5-20251001
CLAUDE_TIMEOUT_MS=3800

# Naver Search API Configuration
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here
NAVER_SEARCH_TIMEOUT_MS=1200
NAVER_SEARCH_DISPLAY=5

# Weather Lookup Configuration
WEATHER_TIMEOUT_MS=1800

# Google Cloud / Calendar Configuration
GOOGLE_CLOUD_API_KEY=your_google_cloud_api_key_here
# Calendar write access needs a service account shared to the target calendar.
GOOGLE_CALENDAR_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your_project_id"}
GOOGLE_CALENDAR_ID=your_calendar_id_here
# User-owned calendar write access needs OAuth, not a service account.
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret_here
# Must match the Authorized redirect URI in Google Cloud OAuth client settings.
GOOGLE_OAUTH_REDIRECT_URI=https://your-app.railway.app/auth/google/callback
PUBLIC_BASE_URL=https://your-app.railway.app
GOOGLE_TOKEN_STORE_PATH=./data/google-calendar-tokens.json
# Comma-separated Kakao user IDs allowed to connect/write Google Calendar.
# Leave empty to block all calendar writes until you explicitly allow users.
KAKAO_CALENDAR_ALLOWED_USER_IDS=kakao_user_id_1,kakao_user_id_2

# KOBIS (Korean Box Office Information System) API Configuration
KOBIS_API_KEY=your_kobis_api_key_here

# Kakao Response Configuration
KAKAO_MAX_RESPONSE_LENGTH=1000
KAKAO_MAX_OUTPUTS=3
KAKAO_HISTORY_MESSAGES=8

# Server Configuration
PORT=3000
