# Claude API Configuration
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-haiku-4-5-20251001
CLAUDE_TIMEOUT_MS=3800

# Naver Search API Configuration
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here
NAVER_SEARCH_TIMEOUT_MS=1200
NAVER_SEARCH_DISPLAY=5

# Weather Lookup Configuration
WEATHER_TIMEOUT_MS=1800

# KOBIS (Korean Box Office Information System) API Configuration
KOBIS_API_KEY=your_kobis_api_key_here

# Kakao Response Configuration
KAKAO_MAX_RESPONSE_LENGTH=1000
KAKAO_MAX_OUTPUTS=3
KAKAO_HISTORY_MESSAGES=8

# Server Configuration
PORT=3000